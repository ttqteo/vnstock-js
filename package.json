{
  "name": "vnstock-js",
  "version": "2.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./indicators": {
      "types": "./dist/indicators.d.ts",
      "import": "./dist/indicators.mjs",
      "require": "./dist/indicators.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.mjs",
      "require": "./dist/proxy.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "indicators": [
        "dist/indicators.d.ts"
      ],
      "proxy": [
        "dist/proxy.d.ts"
      ],
      "node": [
        "dist/node.d.ts"
      ]
    }
  },
  "bin": {
    "vnstock": "bin/vnstock"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "prepare": "husky && npm run build",
    "clean": "rimraf dist",
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:unit": "jest",
    "test:integration": "cross-env INTEGRATION=1 jest --runInBand",
    "test:integration:vn": "cross-env INTEGRATION=1 INTEGRATION_VN=1 jest --runInBand",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "typecheck": "tsc --noEmit -p jest.tsconfig.json",
    "check-docs": "ts-node scripts/check-docs.ts",
    "update-symbols": "ts-node scripts/update-symbols.ts",
    "update-ratios": "ts-node scripts/update-ratios.ts",
    "record-foreign": "ts-node scripts/record-foreign.ts",
    "rollup-foreign": "ts-node scripts/rollup-foreign.ts"
  },
  "keywords": [
    "vnstock",
    "Vietnam stock",
    "Vietnamese stock",
    "vn-index",
    "stock api",
    "Ho Chi Minh stock exchange",
    "hnx",
    "upcom",
    "hsx",
    "vnindex",
    "vietstock",
    "Vietnam finance",
    "stock market",
    "vnstock api",
    "financial data",
    "market data",
    "Vietnamese finance",
    "historical stock data"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttqteo/vnstock-js.git"
  },
  "bugs": {
    "url": "https://github.com/ttqteo/vnstock-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "{src,__tests__}/**/*.ts": "eslint --quiet"
  },
  "homepage": "https://vnstock-js-docs.vercel.app",
  "author": "ttqteo",
  "license": "Apache-2.0",
  "description": "An open source package for fetching stock market data in Vietnam Stock Market.",
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "ws": "^8.22.0"
  }
}
