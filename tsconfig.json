{
  "compilerOptions": {
    "removeComments": false,
    "declarationDir": "dist",
    "outDir": "dist",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
  },
  "ts-node": {
    "compilerOptions": { "module": "CommonJS", "moduleResolution": "node" }
  },
  "exclude": ["examples", "node_modules", "dist"],
  "include": ["src/**/*"]
}
